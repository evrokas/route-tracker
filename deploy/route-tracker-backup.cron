# Reference cron.d entry for Route Tracker's nightly backup + periodic
# health check, via the shared zops engine (lib/zops -- see
# lib/zops/docs/INSTALL.md). Independent of this app's own
# `*/5 * * * * php src/advisor.php` collection cron (see CLAUDE.md) --
# that one runs the app; this one backs it up and watches it.
#
# Install:
#   sudo cp deploy/route-tracker-backup.cron /etc/cron.d/route-tracker-backup
#   sudo chmod 644 /etc/cron.d/route-tracker-backup
#
# See deploy/backup.conf.example's own comment for the recommended
# dedicated "zops" system user and why.

# Nightly backup.
0 2 * * *  zops  flock -n /run/lock/zops-route-tracker-backup.lock /var/www/html/apps/tracker/lib/zops/bin/zops-backup --site=route-tracker >> /var/log/zops/route-tracker-backup-cron.log 2>&1

# Health check every 15 minutes -- --email-on-change means this only
# actually emails the administrator (ADMIN_EMAIL in /etc/zops/defaults.conf)
# when something changes, or a failure has persisted long enough to
# warrant a reminder, not on every single run. This is what actually
# catches the collection cron itself silently dying -- a stopped
# */5 * * * * advisor.php job produces no HTTP symptom at all.
*/15 * * * *  zops  /var/www/html/apps/tracker/lib/zops/bin/zops-monitor --site=route-tracker --email-on-change >> /var/log/zops/route-tracker-monitor-cron.log 2>&1
