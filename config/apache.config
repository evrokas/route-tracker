<VirtualHost *:80>
    ServerName routes.yourdomain.com
    DocumentRoot /var/www/html/apps/tracker/web
    DirectoryIndex dashboard.php

    <Directory /var/www/html/apps/tracker/web>
        AllowOverride All
        Require all granted
    </Directory>

    # Block access to data directory
    <Directory /var/www/html/apps/tracker/data>
        Require all denied
    </Directory>

    # Block sensitive file types
    <FilesMatch "\.(log|sqlite)$">
        Require all denied
    </FilesMatch>
</VirtualHost>
